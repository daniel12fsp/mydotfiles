# config: ln ~/code/personal/mydotfiles/linux/.config/sway/config ~/.config/sway/config

set $mod Mod4

# Output names — find yours with: swaymsg -t get_outputs
#set $laptop eDP-1
#set $middle HDMI-A-1
#set $vertical DP-2

bindsym $mod+F1 focus output $laptop
bindsym $mod+F2 focus output $middle
bindsym $mod+F3 focus output $vertical

# Font for window titles and bar
font pango:monospace, FontAwesome 8

# Lock screen with swaylock before suspend
exec swaylock -f -c 000000

# Idle configuration — lock screen after 300s, turn off displays after 600s
exec swayidle -w \
    timeout 300 'swaylock -f -c 000000' \
    timeout 600 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f -c 000000'

# Volume controls (PulseAudio/PipeWire)
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +10%
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -10%
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec pactl set-source-mute @DEFAULT_SOURCE@ toggle

# Use Mouse+$mod to drag floating windows
floating_modifier $mod normal

# Start a terminal
bindsym $mod+Return exec foot

# Kill focused window
bindsym $mod+Shift+q kill

# App launcher (wofi is a Wayland-native rofi alternative)
bindsym $mod+space exec wofi --show drun

# Change focus
bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+ccedilla focus right

# Alternative: cursor keys
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move focused window
bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+ccedilla move right

# Alternative: cursor keys
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Split in horizontal orientation
bindsym $mod+h splith

# Split in vertical orientation
bindsym $mod+v splitv

# Enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# Change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# Toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# Change focus between tiling / floating windows
bindsym $mod+a+space focus mode_toggle

# Focus the parent container
bindsym $mod+a focus parent

# Focus the child container
#bindsym $mod+d focus child

# Workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

workspace $ws1 output $laptop
workspace $ws4 output $middle
workspace $ws7 output $vertical

bindsym $mod+Ctrl+right move workspace to output right
bindsym $mod+Ctrl+left move workspace to output left

# Reload the configuration file
bindsym $mod+Shift+c reload
# Sway does not support in-place restart — reload is the equivalent
bindsym $mod+Shift+r reload
# Exit sway
bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'

# Resize mode
mode "resize" {
        bindsym j resize shrink width 10 px
        bindsym k resize grow height 10 px
        bindsym l resize shrink height 10 px
        bindsym ccedilla resize grow width 10 px

        bindsym Left resize shrink width 10 px
        bindsym Down resize grow height 10 px
        bindsym Up resize shrink height 10 px
        bindsym Right resize grow width 10 px

        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

title_align center
default_border pixel 1
default_floating_border pixel 1
focus_follows_mouse yes
focus_on_window_activation focus

# Launch browser
bindsym $mod+Shift+Return exec xdg-open https://
# File manager
bindsym $mod+Shift+n exec nemo

# Output configuration — adjust as needed (replaces xrandr)
# Find output names with: swaymsg -t get_outputs
# output $middle pos 0 0 res 1920x1080
# output $laptop pos 1920 0 res 2560x1080

bindsym $mod+n exec ~/code/personal/regolith-rofication/rofication-gui
bindsym $mod+Shift+Delete exec systemctl poweroff
bindsym $mod+Control+Delete exec systemctl reboot

# Screenshots (using grim + slurp for Wayland)
bindsym Ctrl+Print exec grim -g "$(slurp)" - | wl-copy
bindsym Print exec grim /mnt/6e55b6e6-2f8f-4cf8-9f04-e2e2cfb28569/home/Pictures/screenshot/$(date +%Y%m%d_%H%M%S).png
# OCR screenshot (normcap flatpak)
bindsym $mod+Shift+Print exec flatpak run com.github.dynobo.normcap
# Screen recording (wf-recorder replaces peek)
bindsym $mod+Print exec wf-recorder -g "$(slurp)" -f /tmp/recording_$(date +%Y%m%d_%H%M%S).mp4

# Window switcher
bindsym $mod+Ctrl+space exec wofi --show window

bindsym $mod+Pause exec bash ~/bin/give_memory_now.sh

# Autostart
exec_always bash ~/code/personal/mydotfiles/linux/bin/launch_rofication-daemon.sh
# Use waybar instead of polybar for Wayland
exec_always waybar
exec bash ~/code/personal/mydotfiles/linux/bin/launch_docker.sh
exec_always bash ~/code/personal/mydotfiles/linux/bin/launch_mailspring.sh
exec nm-applet --indicator

# Background wallpaper (swaybg replaces feh)
output * bg ~/Pictures fill

# Brightness
bindsym XF86MonBrightnessUp exec brightnessctl set +10%
bindsym XF86MonBrightnessDown exec brightnessctl set 10%-

# Scratchpad
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

bindsym $mod+Shift+m exec mailspring -b --password-store="gnome-libsecret"

# Mark and goto — using swaymsg (Sway supports marks natively)
bindsym $mod+m exec echo "" | wofi --dmenu -p "Mark:" | xargs -I{} swaymsg mark {}
bindsym $mod+g exec swaymsg -t get_marks | jq -r '.[]' | wofi --dmenu -p "Goto:" | xargs -I{} swaymsg '[con_mark="{}"] focus'

# Input configuration (example — adjust for your devices)
# Find input names with: swaymsg -t get_inputs
# input type:touchpad {
#     tap enabled
#     natural_scroll enabled
#     dwt enabled
# }

input type:keyboard {
    xkb_layout br
}

# XWayland support for legacy X11 apps
xwayland enable

# Include additional config files
include /etc/sway/config.d/*
 swaymsg -t get_inputs